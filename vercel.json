{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --no-fund --no-audit",
  "functions": {
    "server/vercel.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/vercel.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
